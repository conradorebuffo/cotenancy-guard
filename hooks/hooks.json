{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run-python\" \"${CLAUDE_PLUGIN_ROOT}/cotenancy_guard/session_hook.py\"", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run-python\" \"${CLAUDE_PLUGIN_ROOT}/cotenancy_guard/session_hook.py\"", "timeout": 10 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run-python\" \"${CLAUDE_PLUGIN_ROOT}/cotenancy_guard/session_hook.py\"", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|NotebookEdit|MultiEdit", "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run-python\" \"${CLAUDE_PLUGIN_ROOT}/cotenancy_guard/touch_hook.py\"", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run-python\" \"${CLAUDE_PLUGIN_ROOT}/cotenancy_guard/bash_hook.py\"", "timeout": 15 } ] }
    ]
  }
}
